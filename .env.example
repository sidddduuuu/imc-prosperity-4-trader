# Optional AI providers
OPENROUTER_API_KEY=
FIREWORKS_API_KEY=

# Optional licensed market data
POLYGON_API_KEY=
TIINGO_API_KEY=
REDIS_URL=

# Frontend (Vercel / Next) — same Auth0 vars + API_URL
API_URL=http://127.0.0.1:8000
