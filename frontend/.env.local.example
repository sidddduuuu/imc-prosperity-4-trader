# Auth0 — copy to frontend/.env.local and backend/.env
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_client_id
AUTH0_CLIENT_SECRET=your_client_secret
AUTH0_SECRET=replace_with_openssl_rand_hex_32
APP_BASE_URL=http://localhost:3000

# Optional Auth0 API audience for direct access-token calls to FastAPI
AUTH0_AUDIENCE=https://api.atlas.terminal

# Atlas API
API_URL=http://127.0.0.1:8000
